{
  "name": "metaplayer-rpc-cdn",
  "version": "1.0.0",
  "description": "Construit app-agent et mp-agent pour le cdn",
  "author": "Capytale.fr",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "bundle": "tsc && vite build",
    "minify": "esbuild lib/app-agent.js lib/mp-agent.js --minify --format=esm --outdir=lib --out-extension:.js=.min.js --splitting --bundle",
    "build": "npm run bundle && npm run minify",
    "clean": "rm -rf lib/"
  },
  "devDependencies": {
    "@capytale/app-agent": "^1.0.12",
    "@capytale/mp-agent": "^1.0.12",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
